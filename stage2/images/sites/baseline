{
	log {
		format json
		output file /data/caddy/logs/web.log {
			roll_size 1gb
			roll_uncompressed
		}
		level debug
	}

	servers {
		import cloudflare_ip_ranges
	}

	servers :443 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

(hsts) {
	header Strict-Transport-Security max-age=63072000
}
